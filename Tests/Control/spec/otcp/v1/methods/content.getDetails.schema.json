{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otcp.invalid/v1/methods/content.getDetails.schema.json",
  "title": "content.getDetails",
  "description": "Returns the state of one content besides its notes and curves: duration, key, pitch shift, analysis state and failure, whether the audible render is current, the time grid with its handles, the reference binding and the AUTO modes. Values that depend on a placement (render, reference, the mode the AUTO button would run) are taken through viaPlacementId: the placement named in the request, or else the first placement that shows the content. analysis.failure is f0_failed or f0_empty when the analysis failed, else null. render.current is true when the audible render reflects the current revision; exports wait for it (PROTOCOL.md section 19). autoModes.uiButtonRuns is the mode the AUTO button would run now: regenerate in the openTune scheme, snapNotes in the openDyne scheme, and reference when the clip has a reference binding (section 21 rule 1); autoModes.available lists the modes of content.autoTune that this content accepts now. timeGrid.seeded is false until the time grid has handles (content.editTimeGrid op seed).",
  "x-otcp": {
    "method": "content.getDetails",
    "layer": "L2",
    "capability": "read.v1",
    "since": "1.0",
    "write": "no",
    "resultKind": "read",
    "startsJob": null,
    "requiresSession": true,
    "mainThread": true,
    "errors": [
      "INVALID_ARGUMENT",
      "NOT_FOUND",
      "UNSUPPORTED",
      "BUSY",
      "TIMEOUT",
      "SHUTTING_DOWN",
      "INTERNAL"
    ]
  },
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentId": {
          "$ref": "../schemas/common.schema.json#/$defs/contentId"
        },
        "placementId": {
          "$ref": "../schemas/common.schema.json#/$defs/placementId"
        }
      },
      "oneOf": [{ "required": ["contentId"] }, { "required": ["placementId"] }]
    },
    "result": {
      "type": "object",
      "allOf": [{ "$ref": "../schemas/common.schema.json#/$defs/readMeta" }],
      "required": [
        "contentId",
        "viaPlacementId",
        "placementIds",
        "durationSec",
        "key",
        "pitchShift",
        "analysis",
        "render",
        "timeGrid",
        "reference",
        "autoModes"
      ],
      "properties": {
        "contentId": {
          "$ref": "../schemas/common.schema.json#/$defs/contentId"
        },
        "viaPlacementId": {
          "$ref": "../schemas/common.schema.json#/$defs/placementId"
        },
        "placementIds": {
          "description": "Every placement that shows this content.",
          "type": "array",
          "items": {
            "$ref": "../schemas/common.schema.json#/$defs/placementId"
          }
        },
        "durationSec": {
          "$ref": "../schemas/common.schema.json#/$defs/secNonNegative"
        },
        "key": {
          "description": "The content's key; null with nullReasons.key not_analyzed until the analysis has determined one.",
          "anyOf": [
            { "$ref": "../schemas/common.schema.json#/$defs/key" },
            { "type": "null" }
          ]
        },
        "pitchShift": {
          "$ref": "../schemas/common.schema.json#/$defs/pitchShift"
        },
        "analysis": {
          "type": "object",
          "required": ["f0State", "failure", "hopSec"],
          "additionalProperties": false,
          "properties": {
            "f0State": {
              "$ref": "../schemas/common.schema.json#/$defs/f0State"
            },
            "failure": {
              "anyOf": [
                { "$ref": "../schemas/common.schema.json#/$defs/reasonCode" },
                { "type": "null" }
              ]
            },
            "hopSec": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "render": {
          "type": "object",
          "required": ["current", "publishedRevision", "desiredRevision"],
          "additionalProperties": false,
          "properties": {
            "current": { "type": "boolean" },
            "publishedRevision": {
              "$ref": "../schemas/common.schema.json#/$defs/revisionToken"
            },
            "desiredRevision": {
              "$ref": "../schemas/common.schema.json#/$defs/revisionToken"
            }
          }
        },
        "timeGrid": {
          "type": "object",
          "required": ["seeded", "identity", "handles"],
          "additionalProperties": false,
          "properties": {
            "seeded": { "type": "boolean" },
            "identity": { "type": "boolean" },
            "handles": {
              "type": "array",
              "items": {
                "$ref": "../schemas/common.schema.json#/$defs/timeHandle"
              }
            }
          }
        },
        "reference": {
          "type": "object",
          "required": ["referencePlacementId", "alignmentReady"],
          "additionalProperties": false,
          "properties": {
            "referencePlacementId": {
              "description": "The placement viaPlacementId has a reference binding to; null when it has none.",
              "anyOf": [
                { "$ref": "../schemas/common.schema.json#/$defs/placementId" },
                { "type": "null" }
              ]
            },
            "alignmentReady": {
              "description": "Reference alignment data for this binding exists.",
              "type": "boolean"
            }
          }
        },
        "autoModes": {
          "type": "object",
          "required": ["editingScheme", "uiButtonRuns", "available"],
          "additionalProperties": false,
          "properties": {
            "editingScheme": {
              "$ref": "../schemas/common.schema.json#/$defs/editingScheme"
            },
            "uiButtonRuns": {
              "$ref": "../schemas/common.schema.json#/$defs/camelName"
            },
            "available": {
              "type": "array",
              "items": {
                "$ref": "../schemas/common.schema.json#/$defs/camelName"
              },
              "uniqueItems": true
            }
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
