{
  "$schema": "../../schemas/vector.schema.json",
  "id": "arrangement/edit-reference-ineligible",
  "type": "request",
  "description": "A clip cannot be bound to itself as its reference: INVALID_ARGUMENT(reference_ineligible).",
  "capability": "arrangement.v1",
  "since": "1.0",
  "method": "arrangement.edit",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "arrangement.edit",
    "params": {
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "ops": [
        {
          "op": "setReference",
          "placementId": { "$ref": "clip.placementId" },
          "referencePlacementId": { "$ref": "clip.placementId" }
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "reference_ineligible",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
