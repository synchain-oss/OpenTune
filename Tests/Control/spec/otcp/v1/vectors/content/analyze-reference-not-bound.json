{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/analyze-reference-not-bound",
  "type": "request",
  "description": "A placement without a reference binding gives INVALID_ARGUMENT(reference_not_bound).",
  "capability": "reference.v1",
  "since": "1.0",
  "method": "content.analyzeReference",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.analyzeReference",
    "params": { "placementId": { "$ref": "clip.placementId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "reference_not_bound",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
