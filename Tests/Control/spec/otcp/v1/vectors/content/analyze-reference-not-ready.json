{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/analyze-reference-not-ready",
  "type": "request",
  "description": "While the pitch analysis of the reference clip runs, the alignment data cannot be computed: NOT_READY(f0_not_ready).",
  "capability": "reference.v1",
  "since": "1.0",
  "method": "content.analyzeReference",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "referenceClip": "ref"
      },
      {
        "bind": "ref",
        "trackId": 1,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "running"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.analyzeReference",
    "params": { "placementId": { "$ref": "clip.placementId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "NOT_READY",
      "data": {
        "kind": "NOT_READY",
        "reason": "f0_not_ready",
        "retryable": true,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
