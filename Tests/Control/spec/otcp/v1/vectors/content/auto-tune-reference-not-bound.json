{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/auto-tune-reference-not-bound",
  "type": "request",
  "description": "AUTO in reference mode on a placement without a reference binding gets INVALID_ARGUMENT(reference_not_bound) and changes nothing.",
  "capability": "edit.v1",
  "extraCapabilities": ["reference.v1"],
  "since": "1.0",
  "method": "content.autoTune",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.autoTune",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "mode": "reference",
      "expectedRevision": { "$ref": "clip.revision" },
      "placementId": { "$ref": "clip.placementId" }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "reference_not_bound",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
