{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/auto-tune-reference",
  "type": "request",
  "description": "AUTO in reference mode aligns the clip to the clip it has a reference binding to. It needs the capability reference.v1 besides edit.v1 and hands the work to a job of kind referenceAnalysis, whose result is the write envelope.",
  "capability": "edit.v1",
  "extraCapabilities": ["reference.v1"],
  "since": "1.0",
  "method": "content.autoTune",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ],
        "referenceClip": "ref"
      },
      {
        "bind": "ref",
        "trackId": 1,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.autoTune",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "mode": "reference",
      "expectedRevision": { "$ref": "clip.revision" },
      "placementId": { "$ref": "clip.placementId" }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "referenceAnalysis",
        "state": { "$any": "string" }
      },
      "omittedCount": { "changes": 0, "created": 0, "removed": 0 },
      "mode": "reference",
      "keyUsed": null,
      "paramsUsed": null,
      "noteCount": null
    }
  },
  "connectionAfter": "open"
}
