{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/get-details-reference-binding",
  "type": "request",
  "description": "A clip with a reference binding, on an instance with reference alignment and experimental features on, in the openTune scheme: the AUTO button would run reference alignment, not regenerate (autoModes.uiButtonRuns reference). This is the trap a leftover binding sets in the OpenTune UI; content.autoTune never infers its mode from it.",
  "capability": "read.v1",
  "extraCapabilities": ["reference.v1"],
  "since": "1.0",
  "method": "content.getDetails",
  "session": "authenticated",
  "given": {
    "editingScheme": "openTune",
    "preferences": { "experimentalFeatures": true },
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ],
        "referenceClip": "ref"
      },
      {
        "bind": "ref",
        "trackId": 1,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.getDetails",
    "params": { "placementId": { "$ref": "clip.placementId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "asOf": { "$any": "object" },
      "derived": { "$any": "array" },
      "contentId": { "$ref": "clip.contentId" },
      "viaPlacementId": { "$ref": "clip.placementId" },
      "placementIds": [{ "$ref": "clip.placementId" }],
      "durationSec": { "$approx": 6 },
      "key": { "$any": true },
      "pitchShift": { "semitones": 0, "cents": 0 },
      "analysis": {
        "f0State": "ready",
        "failure": null,
        "hopSec": { "$any": "number" }
      },
      "render": { "$any": "object" },
      "timeGrid": { "$any": "object" },
      "reference": {
        "referencePlacementId": { "$ref": "ref.placementId" },
        "alignmentReady": false
      },
      "autoModes": {
        "editingScheme": "openTune",
        "uiButtonRuns": "reference",
        "available": { "$any": "array" }
      }
    }
  },
  "connectionAfter": "open"
}
