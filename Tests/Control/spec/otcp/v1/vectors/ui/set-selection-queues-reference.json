{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-selection-queues-reference",
  "type": "request",
  "description": "In the openTune scheme, selecting a clip that has a reference binding, with experimental features on, makes OpenTune queue reference alignment analysis for the contents of both clips that have no alignment data yet (PROTOCOL.md section 21 rule 3): sideEffects.referenceAnalysisQueued and the warning REFERENCE_ANALYSIS_QUEUED, and the reference component of the revision vector changes for both contents. No notes are generated in this scheme. Precondition: no clip is selected and track 0 is the active track, which is the state of a new project; import.start selects the last imported clip and activates its track, so a client that imported the clips resets the selection first.",
  "capability": "ui.bridge",
  "since": "1.0",
  "method": "ui.setSelection",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "editingScheme": "openTune",
    "preferences": { "experimentalFeatures": true },
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "referenceClip": "ref"
      },
      {
        "bind": "ref",
        "trackId": 1,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.setSelection",
    "params": { "placementId": { "$ref": "clip.placementId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "selection",
          "ref": { "singleton": "selection" },
          "label": { "$any": true },
          "fields": {
            "selectedPlacementIds": {
              "before": [],
              "after": [{ "$ref": "clip.placementId" }],
              "unit": null
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "changed": {
              "reference": {
                "before": { "$any": "string" },
                "after": { "$any": "string" }
              }
            }
          },
          {
            "contentId": { "$ref": "ref.contentId" },
            "changed": {
              "reference": {
                "before": { "$any": "string" },
                "after": { "$any": "string" }
              }
            }
          }
        ]
      },
      "tokens": { "$any": "object" },
      "undo": {
        "undoable": false,
        "reason": "not_persisted_state",
        "revert": { "method": "ui.setSelection", "params": { "trackId": 0 } }
      },
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {
        "referenceAnalysisQueued": {
          "contentIds": [
            { "$ref": "clip.contentId" },
            { "$ref": "ref.contentId" }
          ],
          "revert": null
        }
      },
      "warnings": [
        {
          "code": "REFERENCE_ANALYSIS_QUEUED",
          "subject": { "placementId": { "$ref": "clip.placementId" } },
          "data": null
        }
      ],
      "job": null
    }
  },
  "connectionAfter": "open"
}
