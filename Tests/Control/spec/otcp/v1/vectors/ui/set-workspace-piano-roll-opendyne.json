{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-workspace-piano-roll-opendyne",
  "type": "scenario",
  "description": "In the openDyne scheme a clip is selected whose analysis has finished and whose notes were never generated, and the window shows the arrangement view. Selecting such a clip would make OpenTune generate its notes (PROTOCOL.md section 21 rule 3), and so would opening it in the piano roll with ui.setSelection; ui.setWorkspace with pianoRoll must not. The scenario selects the clip in the openTune scheme, where selecting generates nothing, and then switches to openDyne with prefs.set; the piano roll has never been open, so the switch generates nothing either (rule 4: only the clip open in the editor). Then it switches the window to the piano roll: only the view changes, revisionDiff is empty, dirty stays false, sideEffects.workspaceSwitched is the only side effect, warnings is empty (no SELECTION_GENERATED_NOTES, no IRREVERSIBLE), and the piano roll shows the selected clip. A last read confirms that the clip still has no notes.",
  "capability": "ui.workspace",
  "extraCapabilities": ["ui.bridge", "prefs.write", "jobs.v1", "read.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "editingScheme": "openTune",
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "ui.setSelection",
        "params": { "placementId": { "$ref": "clip.placementId" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "applied": true,
          "dirty": { "before": false, "after": false },
          "ui": {
            "workspace": "arrangement",
            "selectedPlacementIds": [{ "$ref": "clip.placementId" }]
          },
          "warnings": []
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "prefs.set",
        "params": { "editingScheme": "openDyne" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$capture": "schemeJob", "$any": "string" },
            "kind": "prefsApply",
            "state": { "$any": "string" }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "job.get",
        "params": { "jobId": { "$ref": "schemeJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "job": {
            "jobId": { "$ref": "schemeJob" },
            "kind": "prefsApply",
            "state": "succeeded",
            "result": {
              "applied": true,
              "noOp": false,
              "changes": [
                {
                  "entity": "preference",
                  "ref": { "preference": "editingScheme" },
                  "label": { "$any": true },
                  "fields": {
                    "editingScheme": {
                      "before": "openTune",
                      "after": "openDyne",
                      "unit": null
                    }
                  }
                }
              ],
              "revisionDiff": {
                "arrangement": null,
                "trackState": null,
                "contents": []
              },
              "dirty": { "before": false, "after": false },
              "warnings": [
                {
                  "code": "GLOBAL_PREFERENCE",
                  "subject": null,
                  "data": { "preferences": ["editingScheme"] }
                }
              ]
            },
            "error": null
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "ui.setWorkspace",
        "params": { "workspace": "pianoRoll" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "applied": true,
          "noOp": false,
          "dryRun": false,
          "changes": [
            {
              "entity": "ui",
              "ref": { "singleton": "workspace" },
              "label": { "$any": true },
              "fields": {
                "workspace": {
                  "before": "arrangement",
                  "after": "pianoRoll",
                  "unit": null
                }
              }
            }
          ],
          "created": [],
          "removed": [],
          "idMap": [],
          "revisionDiff": {
            "arrangement": null,
            "trackState": null,
            "contents": []
          },
          "tokens": {
            "arrangementRevision": { "$any": "string" },
            "contents": [],
            "placements": []
          },
          "undo": {
            "undoable": false,
            "reason": "not_persisted_state",
            "revert": {
              "method": "ui.setWorkspace",
              "params": { "workspace": "arrangement" }
            }
          },
          "dirty": { "before": false, "after": false },
          "ui": {
            "workspace": "pianoRoll",
            "pianoRollContentId": { "$ref": "clip.contentId" },
            "selectedPlacementIds": [{ "$ref": "clip.placementId" }]
          },
          "sideEffects": {
            "workspaceSwitched": {
              "from": "arrangement",
              "to": "pianoRoll",
              "revert": null
            }
          },
          "warnings": [],
          "job": null
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "content.getNotes",
        "params": { "contentId": { "$ref": "clip.contentId" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "result": {
          "contentId": { "$ref": "clip.contentId" },
          "totalCount": 0,
          "notes": [],
          "nextCursor": null
        }
      }
    }
  ]
}
